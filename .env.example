# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Vapi
VAPI_API_KEY=...
VAPI_PHONE_NUMBER_ID=...
VAPI_WEBHOOK_SECRET=...

# Bot skin to activate: healthbot | hvacbot | claimsbot
ACTIVE_SKIN=healthbot

# Scheduling backend: mock | google_calendar | calcom
CALENDAR_BACKEND=mock

# Google Calendar (only if CALENDAR_BACKEND=google_calendar)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json

# Escalation confidence threshold (0.0 – 1.0)
ESCALATION_THRESHOLD=0.4

# Server
PORT=8000
